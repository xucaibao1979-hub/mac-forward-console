# Web 页面监听地址和端口
WEB_HOST=127.0.0.1
WEB_PORT=3000
PUBLIC_HOST=192.168.1.77

# 中央执行服务
EXECUTOR_PORT=8787
CONSOLE_ORIGIN=http://192.168.1.77
CLEAN_TIMEOUT_SECONDS=900
SEND_TIMEOUT_SECONDS=14400

# 永久数据目录：必须放在程序发布目录之外
DATA_DIR=/opt/weixin/mac-forward-console-data

# 仅首次初始化数据时使用；登录后请在“设置”中修改
ADMIN_INITIAL_PASSWORD=123456
# 用于加密VNC等设备凭据；部署后不要随意修改
CONFIG_ENCRYPTION_KEY=change-this-to-a-long-random-secret

# 可选：接口访问密钥。启用前需同步配置 Web 反向代理认证。
EXECUTOR_TOKEN=

# 日志和进程文件目录
RUNTIME_DIR=/opt/weixin/mac-forward-console-runtime
